# =============================================================================
# .GITIGNORE — Projet DevSecOps Portfolio
# =============================================================================

# =============================================================================
# SÉCURITÉ — Ces fichiers ne doivent JAMAIS être committés
# =============================================================================
.env
.env.local
.env.*.local
*.env
terraform.tfvars          # Contient les vraies valeurs (secrets, IPs, etc.)
*.pem                     # Clés SSH privées
*.key                     # Clés privées
kubeconfig                # Fichier de config Kubernetes avec tokens
.aws/credentials          # Credentials AWS

# =============================================================================
# BACKEND — Java / Maven
# =============================================================================
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/.mvn/repository/
*.class
*.jar
!**/src/main/**/
!**/src/test/**/
*.war
*.ear

# IDE Java
backend/.settings/
backend/.classpath
backend/.project
backend/.factorypath
backend/bin/

# =============================================================================
# FRONTEND — Node.js / Angular
# =============================================================================
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/coverage/
frontend/.nyc_output/

# Cypress
frontend/cypress/videos/
frontend/cypress/screenshots/

# =============================================================================
# INFRASTRUCTURE — Terraform
# Note : .terraform.lock.hcl n'est PAS ignoré (bonne pratique : le commiter
# pour figer les versions exactes des providers entre devs et CI).
# =============================================================================
**/.terraform/
*.tfstate
*.tfstate.*
tfplan
*.tfplan
crash.log
# Artefacts de packaging des Lambdas (régénérés par le build)
terraform/modules/**/*.zip
lambdas/**/*.zip

# =============================================================================
# DOCKER
# =============================================================================
# Ne pas ignorer les Dockerfiles, mais ignorer les artefacts locaux
docker-compose.override.yml  # Overrides locaux (non partagés)

# =============================================================================
# IDEs
# =============================================================================
.idea/
.vscode/settings.json
.vscode/launch.json
*.iml
*.iws
*.ipr
.DS_Store
Thumbs.db

# =============================================================================
# LOGS ET TEMPORAIRES
# =============================================================================
*.log
logs/
tmp/
temp/
.cache/

# Crash dumps JVM (hs_err_pid*.log est couvert par *.log, replay_pid* non)
hs_err_pid*
replay_pid*

# Artefacts de session Playwright MCP (screenshots/console de debug)
.playwright-mcp/

# =============================================================================
# OS
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

frontend/junit.xml
