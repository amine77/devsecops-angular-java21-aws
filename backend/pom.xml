<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ================================================================
         PARENT SPRING BOOT
         Raison : gère les versions de toutes les dépendances compatibles.
         On hérite de spring-boot-starter-parent pour ne pas gérer
         manuellement les compatibilités (ex: Hibernate vs Spring Data).
         ================================================================ -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <!-- ================================================================
         COORDONNÉES DU PROJET
         Convention : groupId = nom de domaine inversé de votre org
                      artifactId = nom technique du module
         ================================================================ -->
    <groupId>com.portfolio</groupId>
    <artifactId>backend</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>portfolio-backend</name>
    <description>Portfolio DevSecOps — Backend Spring Boot Java 21</description>

    <!-- ================================================================
         PROPRIÉTÉS GLOBALES
         java.version : force Java 21 pour Virtual Threads (Project Loom)
         ================================================================ -->
    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.6</jjwt.version>
        <springdoc.version>2.8.6</springdoc.version>
        <testcontainers.version>1.21.3</testcontainers.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <!-- lombok.version : héritée du parent Spring Boot (ne pas pinner,
             le parent garantit une version compatible avec le JDK cible) -->
        <cyclonedx.version>2.9.1</cyclonedx.version>
        <!-- GATLING — tests de charge (Phase 14, ex-k6) -->
        <gatling.version>3.13.5</gatling.version>
        <gatling-plugin.version>4.16.3</gatling-plugin.version>

        <!-- ====================================================================
             OVERRIDES SÉCURITÉ — patchs CVE en avance sur le BOM Spring Boot
             Ces propriétés surchargent les versions managées par le parent.
             À RETIRER dès qu'une version de Spring Boot les intègre (vérifier
             à chaque montée de version du parent).
             ==================================================================== -->
        <!-- CVE-2026-41293, CVE-2026-43512, CVE-2026-43515 (gate Trivy/OWASP) -->
        <tomcat.version>10.1.55</tomcat.version>
        <!-- CVE-2026-22732 (fix 6.5.9, Boot 3.5.3 gère 6.5.1) -->
        <spring-security.version>6.5.9</spring-security.version>
    </properties>

    <dependencies>

        <!-- ============================================================
             SPRING WEB (Spring MVC)
             Raison : fournit @RestController, @GetMapping, etc.
             Inclut Tomcat embedded (pas besoin de serveur externe).
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ============================================================
             SPRING DATA JPA + HIBERNATE
             Raison : ORM standard Java. Évite le SQL répétitif pour
             les opérations CRUD. Hibernate génère le SQL automatiquement.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ============================================================
             SPRING SECURITY
             Raison : framework de sécurité standard Java.
             Gère authentification, autorisation, filtres HTTP.
             On va l'étendre avec JWT pour une auth stateless.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ============================================================
             SPRING VALIDATION (Bean Validation / Jakarta Validation)
             Raison : @NotNull, @Email, @Size sur les DTOs.
             Valide les inputs avant qu'ils n'atteignent le Service.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ============================================================
             SPRING ACTUATOR
             Raison : expose /actuator/health pour les probes Kubernetes.
             Liveness probe : /actuator/health/liveness
             Readiness probe : /actuator/health/readiness
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ============================================================
             MICROMETER — PROMETHEUS REGISTRY
             Raison : expose /actuator/prometheus pour Prometheus/Grafana.
             Micrometer est l'abstraction standard de métriques pour JVM.
             Spring Boot l'intègre nativement via Actuator.
             Auto-métriques : JVM heap, GC, threads, HikariCP pool, HTTP
             ============================================================ -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- ============================================================
             LOGSTASH LOGBACK ENCODER — LOGS JSON STRUCTURÉS
             Raison : en production, les logs doivent être parsables par
             CloudWatch Logs Insights, ELK, Datadog, etc.
             Format : {"@timestamp":"...","level":"INFO","message":"...",
                       "requestId":"...","userId":"..."}
             En dev : logs colorés lisibles par l'humain (via logback-spring.xml)
             ============================================================ -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.1</version>
        </dependency>

        <!-- ============================================================
             POSTGRESQL DRIVER
             Raison : driver JDBC pour se connecter à PostgreSQL (RDS).
             Scope runtime : pas besoin au compile time, seulement à l'exécution.
             ============================================================ -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ============================================================
             FLYWAY — DATABASE MIGRATIONS
             Raison : versionning du schéma SQL (comme Git pour la DB).
             Au démarrage, Flyway applique les scripts V1__, V2__ manquants.
             Essentiel pour les déploiements reproductibles.
             ============================================================ -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ============================================================
             JWT — JSON Web Tokens (JJWT library)
             Raison : génération et validation des tokens JWT.
             Auth stateless = pas de session serveur = idéal Kubernetes
             (n'importe quel pod peut valider n'importe quel token).
             ============================================================ -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ============================================================
             SPRINGDOC OPENAPI 3 (Swagger UI)
             Raison : génère automatiquement la documentation API.
             Interface interactive sur /swagger-ui.html
             Essentiel pour démontrer l'API aux recruteurs.
             ============================================================ -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ============================================================
             LOMBOK
             Raison : réduit le boilerplate Java (@Getter, @Builder, etc.)
             Attention : à utiliser avec modération. Préférer les records
             Java 21 pour les DTOs immutables.
             ============================================================ -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- ============================================================
             MAPSTRUCT — BEAN MAPPING
             Raison : mapping Entity ↔ DTO généré à la compilation.
             Plus performant que les mappers réflexifs (ModelMapper).
             Null-safe, typé, rapide.
             ============================================================ -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct-processor</artifactId>
            <version>${mapstruct.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- ============================================================
             SPRING KAFKA
             Raison : intégration Spring Boot avec Apache Kafka.
             Fournit KafkaTemplate (producer), @KafkaListener (consumer),
             KafkaAdmin (création de topics), sérialisation JSON via Jackson.
             Micrometer auto-configure les métriques Kafka → /actuator/prometheus.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- ============================================================
             SPRING DATA REDIS + SPRING CACHE
             Raison : cache distribué pour les endpoints publics (GET /projects).
             Réduit la charge DB sur Free Tier RDS en mettant en cache les
             réponses JSON. TTL 5 min → cohérence acceptable pour un portfolio.
             Micrometer auto-expose les métriques de cache via /actuator/prometheus.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- ============================================================
             CAFFEINE — cache local borné (rate limiting anti-brute-force)
             Raison : les compteurs de tentatives de login sont volontairement
             LOCAUX, pas dans Redis. Un contrôle de sécurité ne doit pas
             dépendre d'un service réseau qui peut tomber : si Redis est
             indisponible, le CacheErrorHandler dégrade la lecture des projets
             en lecture DB (acceptable), mais un rate limiter qui dégrade
             s'ouvre — et c'est précisément l'inverse de ce qu'on veut.
             Caffeine apporte les deux choses difficiles à écrire à la main :
             expiration par entrée (fenêtre glissante) et taille bornée
             (un attaquant qui fait tourner les IP ne peut pas faire grossir
             la map jusqu'à l'OOM).
             Version gérée par le BOM Spring Boot — rien à pinner ni à suivre.
             ============================================================ -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- ============================================================
             H2 — BASE DE DONNÉES EN MÉMOIRE (dev/test uniquement)
             Raison : tests rapides sans PostgreSQL installé localement.
             Scope test : présent uniquement dans les tests.
             ============================================================ -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ============================================================
             SPRING BOOT TEST
             Raison : @SpringBootTest, @WebMvcTest, MockMvc, etc.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ============================================================
             SPRING SECURITY TEST
             Raison : @WithMockUser, SecurityMockMvcRequestPostProcessors
             pour tester les endpoints sécurisés.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ============================================================
             TESTCONTAINERS — INTÉGRATION TESTS AVEC VRAI POSTGRESQL
             Raison : démarre un vrai conteneur PostgreSQL durant les tests.
             Évite les surprises de compatibilité H2 vs PostgreSQL.
             ============================================================ -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ============================================================
             GATLING — TESTS DE CHARGE (Java DSL)
             Raison : simulateur de charge JVM-natif (remplace k6, Phase 14).
             Scope test : jamais embarqué dans le JAR applicatif exécutable.
             Simulations : src/test/java/com/portfolio/backend/loadtest/
             Lancement : mvn gatling:test -Dgatling.simulationClass=<FQCN>
             ============================================================ -->
        <dependency>
            <groupId>io.gatling.highcharts</groupId>
            <artifactId>gatling-charts-highcharts</artifactId>
            <version>${gatling.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- ============================================================
                 SPRING BOOT MAVEN PLUGIN
                 Raison : crée un JAR exécutable "fat jar" avec toutes
                 les dépendances embarquées.
                 java -jar backend.jar → démarre directement.
                 exclude Lombok : pas besoin dans le JAR final.
                 ============================================================ -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                    <!-- Layered JAR : optimise le cache Docker layer -->
                    <layers>
                        <enabled>true</enabled>
                    </layers>
                    <!--
                        IMPORTANT : spring-boot:run active optimizedLaunch=true par défaut,
                        ce qui injecte -XX:TieredStopAtLevel=1 pour accélérer le démarrage.
                        Cela désactive le JIT C2, faisant passer BCrypt strength=12 de ~300ms
                        à ~20s par hash → timeout login en développement natif inacceptable.
                        On désactive cette optimisation pour restaurer le C2 JIT complet.
                    -->
                    <optimizedLaunch>false</optimizedLaunch>
                </configuration>
            </plugin>

            <!-- ============================================================
                 MAVEN COMPILER PLUGIN
                 Raison : configure les annotation processors (Lombok + MapStruct).
                 L'ordre est important : Lombok d'abord, MapStruct ensuite
                 (MapStruct voit les méthodes générées par Lombok).
                 ============================================================ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- ============================================================
                 CHECKSTYLE
                 Raison : applique les règles de style Java automatiquement.
                 Le build échoue si le code ne respecte pas les conventions.
                 Démontre la rigueur de code aux recruteurs.
                 ============================================================ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <!-- 3.5.0 : compatible Maven 3.9 + Guava 32 (3.3.1 avait un conflit Guava) -->
                <version>3.5.0</version>
                <configuration>
                    <configLocation>checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>true</failsOnError>
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>validate</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- ============================================================
                 JACOCO — CODE COVERAGE
                 Raison : mesure la couverture de tests.
                 Génère un rapport HTML dans target/site/jacoco/
                 Minimum 70% de couverture de lignes imposé (aligné avec la CI).
                 ============================================================ -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <configuration>
                    <!-- Exclusions : code généré (Lombok entities, MapStruct mappers)
                         Ces classes ne contiennent pas de logique métier à tester.
                         JaCoCo mesure la couverture du code MÉTIER uniquement. -->
                    <excludes>
                        <exclude>com/portfolio/backend/entity/**</exclude>
                        <exclude>com/portfolio/backend/mapper/**</exclude>
                        <exclude>com/portfolio/backend/BackendApplication.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ============================================================
                 CYCLONEDX — SBOM (Software Bill of Materials)
                 Raison : génère un inventaire complet des dépendances
                 au format CycloneDX (standard OWASP).
                 Utilisé pour la sécurité de la chaîne d'approvisionnement
                 (supply chain security) et la conformité réglementaire.
                 Produit : target/bom.json + target/bom.xml
                 Lancement : mvn cyclonedx:makeAggregateBom
                 ============================================================ -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedx.version}</version>
                <configuration>
                    <projectType>library</projectType>
                    <schemaVersion>1.5</schemaVersion>
                    <includeBomSerialNumber>true</includeBomSerialNumber>
                    <includeCompileScope>true</includeCompileScope>
                    <includeProvidedScope>true</includeProvidedScope>
                    <includeRuntimeScope>true</includeRuntimeScope>
                    <includeSystemScope>true</includeSystemScope>
                    <includeTestScope>false</includeTestScope>
                    <includeLicenseText>false</includeLicenseText>
                    <outputFormat>all</outputFormat>
                    <outputName>bom</outputName>
                </configuration>
                <executions>
                    <execution>
                        <id>generate-sbom</id>
                        <phase>package</phase>
                        <goals>
                            <goal>makeAggregateBom</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- ============================================================
                 GATLING MAVEN PLUGIN
                 Raison : exécute les simulations Java DSL (tests de charge).
                 Pas d'<executions> : jamais déclenché par "mvn test"/"mvn verify",
                 uniquement via "mvn gatling:test" (comme k6 était manuel en CI).
                 ============================================================ -->
            <plugin>
                <groupId>io.gatling</groupId>
                <artifactId>gatling-maven-plugin</artifactId>
                <version>${gatling-plugin.version}</version>
                <configuration>
                    <runMultipleSimulations>true</runMultipleSimulations>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
