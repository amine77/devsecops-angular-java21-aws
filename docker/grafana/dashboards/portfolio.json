      "type": "gauge",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(auth_login_failure_total[5m]) / (rate(auth_login_success_total[5m]) + rate(auth_login_failure_total[5m]) + 0.0001)",
          "legendFormat": "Ratio d'échec",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
