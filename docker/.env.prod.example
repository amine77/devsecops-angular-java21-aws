# =============================================================================
# .env.prod.example — Template des variables d'environnement production
# =============================================================================
# INSTRUCTIONS :
#   1. Copier ce fichier : cp .env.prod.example .env.prod
#   2. Remplir les valeurs réelles
#   3. NE JAMAIS committer .env.prod (il est dans .gitignore)
#
# GÉNÉRATION DES SECRETS :
#   JWT_SECRET (256+ bits en base64) :
#     openssl rand -base64 48
#
#   POSTGRES_PASSWORD (fort) :
#     openssl rand -base64 24
# =============================================================================

# Base de données PostgreSQL
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# JWT — HMAC-SHA256 nécessite 256 bits minimum (32 bytes = 43 caractères base64)
# Exemple de génération : openssl rand -base64 48
JWT_SECRET=CHANGE_ME_minimum_256_bits_base64_encoded_secret_key_here
